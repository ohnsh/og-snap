{
  "name": "og-snap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "vite",
    "types": "cf workers types",
    "check": "cf workers types && tsc --noEmit",
    "build": "bun run check && vite build",
    "deploy": "bun run build && cf deploy --prebuilt --mode production",
    "test": "bun test test/unit",
    "test:browser": "playwright test",
    "test:worker": "bun run build && node --test test/worker/*.test.mjs",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.17",
    "miniflare": "5.20261012.0-beta",
    "oxfmt": "0.73.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.4"
}
