{
  "name": "og-snap",
  "version": "0.2.0",
  "private": true,
  "files": [
    "src/client.ts",
    "src/types.ts",
    "src/manifest.ts",
    "src/journal.ts",
    "src/cli.ts",
    "src/meta.ts"
  ],
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./journal": "./src/journal.ts",
    "./cli": "./src/cli.ts",
    "./meta": "./src/meta.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "vite",
    "types": "cf workers types",
    "check": "cf workers types && tsc --noEmit",
    "build": "bun run check && vite build",
    "deploy": "bun run build && cf deploy --prebuilt --mode production",
    "test": "bun test test/unit",
    "test:browser": "playwright test",
    "test:worker": "bun run build && node --test test/worker/*.test.mjs",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.4.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "cf": "^1.0.0-beta.31",
    "miniflare": "5.20261012.0-beta",
    "oxfmt": "^0.78.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.4"
}
